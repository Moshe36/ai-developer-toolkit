{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Optimized for performance with minimal false positives.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "create skill",
                    "skill rules",
                    "hook system",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(create|modify|build).*?skill",
                    "skill.*(trigger|activate|system)"
                ]
            }
        },
        "backend-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Project-aware Java/Spring backend design, APIs, security, async/state contracts, configuration, and testing across Boot 3/4",
            "promptTriggers": {
                "keywords": [
                    "spring boot",
                    "spring graphql",
                    "mapstruct",
                    "lombok",
                    "completablefuture",
                    "backend-dev-guidelines"
                ],
                "intentPatterns": [
                    "^(?=[\\s\\S]*\\b(java|spring|jpa|jdbc|hibernate|jackson|reactor)\\b)[\\s\\S]*\\b(controller|service|repository|endpoint|api|validation|caching|async|concurrency|cancellation|deadline|timeout|shutdown|lifecycle|security|authorization|jwt|websocket|bean|serialization|migration|test|tests)\\b",
                    "^(?=[\\s\\S]*\\b(spring|jpa|jdbc|hibernate|jackson|reactor)\\b)[\\s\\S]*\\b(create|implement|add|fix|debug|refactor|review|test|configure|migrate|upgrade)\\b",
                    "\\bvirtual[- ]threads?\\b",
                    "\\b(QueryMapping|MutationMapping|SubscriptionMapping|GraphQlTest|WebMvcTest|ConfigurationProperties|PreAuthorize)\\b",
                    "^(?![\\s\\S]*\\b(frontend|react|angular|vue|apollo|express|nestjs|node\\.?js|python|django|fastapi|asp\\.net)\\b)(?=[\\s\\S]*\\bbackend\\b)[\\s\\S]*\\b(controller|service|repository|endpoint|api|jwt|authorization|authentication|security|subscription|persistence|validation|caching)\\b",
                    "^(?![\\s\\S]*\\b(frontend|react|angular|vue|apollo|express|nestjs|node\\.?js|python|django|fastapi|asp\\.net)\\b)(?=[\\s\\S]*\\bgraphql\\b)[\\s\\S]*\\b(schema|resolver|resolvers|subscription|subscriptions|server)\\b"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/src/main/java/**/*.java",
                    "**/src/test/java/**/*.java",
                    "**/src/{main,test}/resources/**/*.{yml,yaml,properties}",
                    "**/src/main/resources/graphql/**/*.{graphqls,gqls}",
                    "**/pom.xml",
                    "**/build.gradle",
                    "**/build.gradle.kts"
                ],
                "pathExclusions": [
                    "**/target/**",
                    "**/build/**",
                    "**/generated-sources/**"
                ],
                "contentPatterns": [
                    "@Service",
                    "@Controller",
                    "@RestController",
                    "@Repository",
                    "@QueryMapping",
                    "@MutationMapping",
                    "@SubscriptionMapping",
                    "@PreAuthorize",
                    "@ConfigurationProperties",
                    "@GraphQlTest",
                    "@WebMvcTest",
                    "@MockitoBean",
                    "@Mapper.*componentModel"
                ]
            }
        },
        "frontend-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "React/TypeScript best practices with Apollo Client, Redux Toolkit, Tailwind CSS",
            "promptTriggers": {
                "keywords": [
                    "component",
                    "apollo",
                    "redux slice",
                    "shadcn",
                    "react hook form"
                ],
                "intentPatterns": [
                    "(create|add|build).*(component|feature|UI|page)",
                    "(apollo|graphql).*(query|mutation)",
                    "redux.*(slice|selector)",
                    "tailwind.*style"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "frontend/src/**/*.tsx",
                    "src/**/*.tsx",
                    "src/features/**/*.ts",
                    "src/redux/**/*.ts"
                ],
                "pathExclusions": [
                    "**/*.test.tsx",
                    "**/*.test.ts",
                    "**/generatedTypes/**"
                ],
                "contentPatterns": [
                    "from '@apollo/client'",
                    "useQuery",
                    "useMutation",
                    "createSlice",
                    "useAppSelector",
                    "from '@/components/ui",
                    "useForm"
                ]
            },
            "skipConditions": {
                "sessionSkillUsed": true,
                "fileMarkers": [
                    "@skip-validation"
                ]
            }
        },
        "error-tracking": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Sentry error tracking for frontend and backend services",
            "promptTriggers": {
                "keywords": [
                    "error handling",
                    "sentry",
                    "captureException",
                    "error boundary",
                    "apollo error"
                ],
                "intentPatterns": [
                    "(add|implement).*(error handling|sentry|error tracking)",
                    "(fix|handle|catch).*(error|exception)",
                    "(apollo|graphql).*(error|handling)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/instrument.ts",
                    "**/sentry*.ts",
                    "**/*Controller.ts",
                    "**/*Service.ts",
                    "**/ErrorBoundary.tsx",
                    "**/apollo/client.ts"
                ],
                "contentPatterns": [
                    "@sentry",
                    "Sentry\\.",
                    "captureException",
                    "ErrorBoundary",
                    "onError.*from.*@apollo"
                ]
            }
        },
        "mapping-project-overview": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Backend architecture overview mapping from code or maintained architecture JSON into readable manual SVG artifacts",
            "promptTriggers": {
                "keywords": [
                    "architecture overview",
                    "project overview",
                    "svg diagram",
                    "feature panel",
                    "architecture json"
                ],
                "intentPatterns": [
                    "(create|build|generate|refresh|update).*(architecture|project).*(overview|diagram|svg)",
                    "(map|document).*(backend|service|repository).*(architecture|relationships)",
                    "(maintain|update).*(architecture json|overview svg|feature panel)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/docs/architecture/**/*.json",
                    "**/docs/architecture/**/*.svg",
                    "**/APP_ARCHITECTURE_DIAGRAM.md",
                    "**/src/main/java/**/*.java",
                    "**/src/main/resources/graphql/**/*.graphqls"
                ],
                "pathExclusions": [
                    "**/target/**",
                    "**/src/test/**/*.java",
                    "**/*Test.java"
                ],
                "contentPatterns": [
                    "@QueryMapping",
                    "@MutationMapping",
                    "@Service",
                    "@Repository",
                    "<svg",
                    "\\\"features\\\"\\s*:",
                    "GraphQL schema"
                ]
            }
        },
        "grill-me": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Interview the user relentlessly to stress-test plans and designs",
            "promptTriggers": {
                "keywords": [
                    "grill me",
                    "stress-test",
                    "poke holes",
                    "stress test my"
                ],
                "intentPatterns": [
                    "grill.*(me|this|plan|design|idea)",
                    "(stress[- ]test|challenge|question).*(plan|design|approach|idea)",
                    "(review|validate|sanity.check).*(design|plan|approach)"
                ]
            }
        },
        "grill-with-docs": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Grill session that challenges plan against existing domain model and updates CONTEXT.md/ADRs inline",
            "promptTriggers": {
                "keywords": [
                    "grill with docs",
                    "domain model",
                    "context map",
                    "CONTEXT.md"
                ],
                "intentPatterns": [
                    "grill.*(docs|domain|context|model)",
                    "(challenge|stress.test).*(domain|glossary|model|terminology)"
                ]
            }
        },
        "writing-clearly-and-concisely": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Apply Strunk's Elements of Style rules to documentation and prose",
            "promptTriggers": {
                "keywords": [
                    "write documentation",
                    "improve writing",
                    "write readme",
                    "write docs"
                ],
                "intentPatterns": [
                    "(write|improve|edit|review).*(doc|readme|documentation|prose|text|copy|message)",
                    "(clear|concise|better).*(writing|prose|docs|documentation)"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "optimization": {
            "keywords": "Use 5-7 high-signal keywords only",
            "intentPatterns": "Regex patterns catch variations",
            "performance": "Reduced from 30+ keywords to ~5 per skill for faster matching"
        }
    }
}
