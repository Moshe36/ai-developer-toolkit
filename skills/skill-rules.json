{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Optimized for performance with minimal false positives.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "create skill",
                    "skill rules",
                    "hook system",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(create|modify|build).*?skill",
                    "skill.*(trigger|activate|system)"
                ]
            }
        },
        "backend-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Backend development patterns for Java 21, Spring Boot 3.x, GraphQL, REST APIs",
            "promptTriggers": {
                "keywords": [
                    "spring boot",
                    "controller",
                    "graphql",
                    "mapstruct",
                    "repository"
                ],
                "intentPatterns": [
                    "(create|implement).*(controller|service|repository|endpoint|API)",
                    "(add|implement).*(validation|caching|async)",
                    "spring.*(bean|cache|security)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/src/main/java/**/*.java",
                    "**/src/main/resources/**/*.yml",
                    "**/src/main/resources/graphql/**/*.graphqls"
                ],
                "pathExclusions": [
                    "**/src/test/**/*.java",
                    "**/*Test.java"
                ],
                "contentPatterns": [
                    "@Service",
                    "@Controller",
                    "@RestController",
                    "@Repository",
                    "@QueryMapping",
                    "@MutationMapping",
                    "@Mapper.*componentModel"
                ]
            }
        },
        "frontend-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "React/TypeScript best practices with Apollo Client, Redux Toolkit, Tailwind CSS",
            "promptTriggers": {
                "keywords": [
                    "component",
                    "apollo",
                    "redux slice",
                    "shadcn",
                    "react hook form"
                ],
                "intentPatterns": [
                    "(create|add|build).*(component|feature|UI|page)",
                    "(apollo|graphql).*(query|mutation)",
                    "redux.*(slice|selector)",
                    "tailwind.*style"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "frontend/src/**/*.tsx",
                    "src/**/*.tsx",
                    "src/features/**/*.ts",
                    "src/redux/**/*.ts"
                ],
                "pathExclusions": [
                    "**/*.test.tsx",
                    "**/*.test.ts",
                    "**/generatedTypes/**"
                ],
                "contentPatterns": [
                    "from '@apollo/client'",
                    "useQuery",
                    "useMutation",
                    "createSlice",
                    "useAppSelector",
                    "from '@/components/ui",
                    "useForm"
                ]
            },
            "skipConditions": {
                "sessionSkillUsed": true,
                "fileMarkers": [
                    "@skip-validation"
                ]
            }
        },
        "error-tracking": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Sentry error tracking for frontend and backend services",
            "promptTriggers": {
                "keywords": [
                    "error handling",
                    "sentry",
                    "captureException",
                    "error boundary",
                    "apollo error"
                ],
                "intentPatterns": [
                    "(add|implement).*(error handling|sentry|error tracking)",
                    "(fix|handle|catch).*(error|exception)",
                    "(apollo|graphql).*(error|handling)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/instrument.ts",
                    "**/sentry*.ts",
                    "**/*Controller.ts",
                    "**/*Service.ts",
                    "**/ErrorBoundary.tsx",
                    "**/apollo/client.ts"
                ],
                "contentPatterns": [
                    "@sentry",
                    "Sentry\\.",
                    "captureException",
                    "ErrorBoundary",
                    "onError.*from.*@apollo"
                ]
            }
        },
        "mapping-project-overview": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Backend architecture overview mapping from code or maintained architecture JSON into readable manual SVG artifacts",
            "promptTriggers": {
                "keywords": [
                    "architecture overview",
                    "project overview",
                    "svg diagram",
                    "feature panel",
                    "architecture json"
                ],
                "intentPatterns": [
                    "(create|build|generate|refresh|update).*(architecture|project).*(overview|diagram|svg)",
                    "(map|document).*(backend|service|repository).*(architecture|relationships)",
                    "(maintain|update).*(architecture json|overview svg|feature panel)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/docs/architecture/**/*.json",
                    "**/docs/architecture/**/*.svg",
                    "**/APP_ARCHITECTURE_DIAGRAM.md",
                    "**/src/main/java/**/*.java",
                    "**/src/main/resources/graphql/**/*.graphqls"
                ],
                "pathExclusions": [
                    "**/target/**",
                    "**/src/test/**/*.java",
                    "**/*Test.java"
                ],
                "contentPatterns": [
                    "@QueryMapping",
                    "@MutationMapping",
                    "@Service",
                    "@Repository",
                    "<svg",
                    "\\\"features\\\"\\s*:",
                    "GraphQL schema"
                ]
            }
        },
        "grill-me": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Interview the user relentlessly to stress-test plans and designs",
            "promptTriggers": {
                "keywords": [
                    "grill me",
                    "stress-test",
                    "poke holes",
                    "stress test my"
                ],
                "intentPatterns": [
                    "grill.*(me|this|plan|design|idea)",
                    "(stress[- ]test|challenge|question).*(plan|design|approach|idea)",
                    "(review|validate|sanity.check).*(design|plan|approach)"
                ]
            }
        },
        "grill-with-docs": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Grill session that challenges plan against existing domain model and updates CONTEXT.md/ADRs inline",
            "promptTriggers": {
                "keywords": [
                    "grill with docs",
                    "domain model",
                    "context map",
                    "CONTEXT.md"
                ],
                "intentPatterns": [
                    "grill.*(docs|domain|context|model)",
                    "(challenge|stress.test).*(domain|glossary|model|terminology)"
                ]
            }
        },
        "ponytail": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Forces the laziest solution that works: YAGNI, stdlib-first, shortest diff",
            "promptTriggers": {
                "keywords": [
                    "ponytail",
                    "be lazy",
                    "lazy mode",
                    "yagni",
                    "over-engineered"
                ],
                "intentPatterns": [
                    "simplest.*(solution|approach|way)",
                    "(minimal|shortest).*(solution|path|code)",
                    "(too much|unnecessary).*(boilerplate|abstraction|complexity)"
                ]
            }
        },
        "ponytail-review": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Over-engineering review: finds what to delete, shrink, or replace with stdlib",
            "promptTriggers": {
                "keywords": [
                    "ponytail-review",
                    "over-engineering review",
                    "what can we delete"
                ],
                "intentPatterns": [
                    "review.*(over.engin|complexity|bloat)",
                    "is this over.engin"
                ]
            }
        },
        "ponytail-audit": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Whole-repo audit for over-engineering: ranked list of what to cut",
            "promptTriggers": {
                "keywords": [
                    "ponytail-audit",
                    "audit for over-engineering",
                    "find bloat"
                ],
                "intentPatterns": [
                    "audit.*(codebase|repo).*(over.engin|bloat|complexity)",
                    "what can.*(delete|remove).*(repo|codebase)"
                ]
            }
        },
        "ponytail-debt": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Harvest ponytail: comments into a debt ledger",
            "promptTriggers": {
                "keywords": [
                    "ponytail debt",
                    "ponytail-debt",
                    "ponytail ledger"
                ],
                "intentPatterns": [
                    "what did ponytail defer",
                    "list.*(shortcuts|deferrals)"
                ]
            }
        },
        "ponytail-gain": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "low",
            "description": "Show ponytail's measured impact scoreboard",
            "promptTriggers": {
                "keywords": [
                    "ponytail-gain",
                    "ponytail gain",
                    "ponytail scoreboard"
                ],
                "intentPatterns": [
                    "what does ponytail save",
                    "show ponytail impact"
                ]
            }
        },
        "ponytail-help": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "low",
            "description": "Quick-reference card for all ponytail modes and commands",
            "promptTriggers": {
                "keywords": [
                    "ponytail-help",
                    "ponytail help"
                ],
                "intentPatterns": [
                    "what ponytail commands",
                    "how.*(use|work).*(ponytail)"
                ]
            }
        },
        "writing-clearly-and-concisely": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Apply Strunk's Elements of Style rules to documentation and prose",
            "promptTriggers": {
                "keywords": [
                    "write documentation",
                    "improve writing",
                    "write readme",
                    "write docs"
                ],
                "intentPatterns": [
                    "(write|improve|edit|review).*(doc|readme|documentation|prose|text|copy|message)",
                    "(clear|concise|better).*(writing|prose|docs|documentation)"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "optimization": {
            "keywords": "Use 5-7 high-signal keywords only",
            "intentPatterns": "Regex patterns catch variations",
            "performance": "Reduced from 30+ keywords to ~5 per skill for faster matching"
        }
    }
}
